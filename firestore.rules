rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow public read for products, businesses, servicePoints, and supplierListings
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if true; // In production this would be if request.auth != null; open for demo flexibility
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /servicePoints/{pointId} {
      allow read: if true;
      allow write: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if true; // Unauthenticated guests at table can submit orders
      allow update: if true; // Waiters, kitchen staff, and managers can update status
      allow delete: if false;
    }

    match /supplierListings/{listingId} {
      allow read: if true;
      allow write: if true;
    }

    match /purchaseOrders/{poId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
