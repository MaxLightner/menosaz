{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host=127.0.0.1 --port=4180",
    "build": "vite build",
    "preview": "vite preview --host=127.0.0.1 --port=4180",
    "clean": "node --input-type=module -e \"import {rm} from 'node:fs/promises'; await rm('dist', {recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "test:catalog": "node scripts/test-catalog.mjs",
    "test:access": "node scripts/test-catalog.mjs --access",
    "test:domains": "node scripts/test-catalog.mjs --platform",
    "test:notifications": "tsx scripts/test-notifications.ts",
    "test:billing": "tsx scripts/test-billing.mjs",
    "test:customer": "node --import tsx scripts/test-customer-regressions.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
