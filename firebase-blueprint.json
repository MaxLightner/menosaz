{
  "entities": {
    "Business": {
      "title": "Business",
      "description": "Restaurant or hospitality business profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string" },
        "orderAcceptanceActive": { "type": "boolean" },
        "activeTemplate": { "type": "string" }
      },
      "required": ["id", "name", "slug"]
    },
    "Product": {
      "title": "Product",
      "description": "Menu dish or beverage item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "isAvailable": { "type": "boolean" },
        "outOfStockReason": { "type": "string" },
        "imageUrl": { "type": "string" },
        "prepTimeMinutes": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "businessId", "name", "price", "isAvailable"]
    },
    "ServicePoint": {
      "title": "ServicePoint",
      "description": "Dining table or ordering station",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "tableNumber": { "type": "number" },
        "section": { "type": "string" },
        "label": { "type": "string" },
        "isOccupied": { "type": "boolean" },
        "qrCode": { "type": "string" }
      },
      "required": ["id", "businessId", "tableNumber"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer dining table order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessId": { "type": "string" },
        "tableNumber": { "type": "number" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerNotes": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "deliveryStatus": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "idempotencyKey": { "type": "string" }
      },
      "required": ["id", "businessId", "tableNumber", "totalAmount", "status", "deliveryStatus", "paymentStatus"]
    },
    "SupplierListing": {
      "title": "SupplierListing",
      "description": "B2B wholesale inventory listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplierName": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "minOrder": { "type": "string" },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "isFeatured": { "type": "boolean" }
      },
      "required": ["id", "supplierName", "title", "price", "unit"]
    }
  },
  "firestore": {
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Business restaurant settings and details"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Dishes and drinks catalog"
    },
    "/servicePoints/{pointId}": {
      "schema": "ServicePoint",
      "description": "Tables and QR points"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Live guest orders"
    },
    "/supplierListings/{listingId}": {
      "schema": "SupplierListing",
      "description": "B2B wholesale listings"
    }
  }
}
